{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lastro",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180,
      "cwd": "app"
    },
    {
      "name": "painel",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8731",
        "--directory",
        "dist"
      ],
      "port": 8731
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8742",
        "--directory",
        "app/dist"
      ],
      "port": 8742
    },
    {
      "name": "radar",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8755",
        "--directory",
        "radar/dist"
      ],
      "port": 8755
    }
  ]
}
